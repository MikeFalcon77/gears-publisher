# /etc/gears-publisher/publisher.env (generated by provision.sh; root:publisher 0640)
DATABASE_URL=postgres://publisher:__DB_PASSWORD__@127.0.0.1:5432/publisher
FIREBASE_PROJECT_ID=__FIREBASE_PROJECT_ID__
PUBLISHER_BIND=127.0.0.1:8080
PUBLISHER_WORK_DIR=/var/lib/gears-publisher
PUBLISHER_TARGET_DIR=/var/lib/gears-publisher/target
PUBLISHER_SECRETS=/etc/gears-publisher/secrets.env
PUBLISHER_WEB_ROOT=/opt/gears-publisher/web/dist
PUBLISHER_PYTHON=/opt/gears-publisher/venv/bin/python
# Everything that runs gears-rust's code runs as this user (deploy/sudoers).
PUBLISHER_RUN_AS=publisher-build
# 20 vCPU / 16 GiB: more parallel rustc+link jobs risk OOM in test builds.
PUBLISHER_CARGO_JOBS=12
PUBLISHER_CLEAN_CARGO_HOME=/var/lib/gears-publisher-build/.cargo
HOME=/home/publisher
PATH=/usr/local/bin:/usr/bin:/bin

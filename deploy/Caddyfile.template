# Generated by provision.sh. TLS from Let's Encrypt for the sslip.io name.
# Only the application's paths are proxied; everything else the server exposes
# (types-registry REST, /health, /readyz) stays on 127.0.0.1.
__DOMAIN__ {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Server-Sent Events: no compression, every line passed through at once.
	@stream path_regexp ^/publisher/v1/runs/[0-9a-fA-F-]+/stream$
	handle @stream {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}

	@app path / /index.html /favicon.svg /runs/* /assets/* /publisher/v1/*
	handle @app {
		encode gzip
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		respond "Not found" 404
	}
}
